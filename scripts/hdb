#!/usr/bin/env bash
# healthapp database helper. Never links, pushes or resets conductor.
#   hdb render <dev|demo> <file.sql>  print the SQL with names filled in (apply it with the
#                                     Supabase connector's execute_sql, or psql "$HDB_DATABASE_URL")
#   hdb check  <dev|demo>             print the zero-count check (every number must be 0);
#                                     runs it when HDB_DATABASE_URL is set
#   hdb files  <dev|demo>             print the counts-only file analysis check (six values, no row content)
#   hdb scan   <dev|demo>             print the counts-only scan check (uploads, per status, refused per reason, stuck...)
#   hdb kept   <dev|demo>             print the 017 check (refused rows keep a file only with its 14-day end; reads no row)
set -euo pipefail
cmd="${1:-}"; env="${2:-}"
case "$env" in dev|demo) ;; *) echo "usage: hdb render|check dev|demo [file]" >&2; exit 2;; esac
schema="healthapp_${env}"; bucket="healthapp-${env}"
dir="$(cd "$(dirname "$0")/../supabase/sql" && pwd)"
run() { if [ -n "${HDB_DATABASE_URL:-}" ]; then psql "$HDB_DATABASE_URL" -X -v ON_ERROR_STOP=1 -1; else cat; fi; }
case "$cmd" in
  render)
    f="${3:?file}"; [[ "$f" =~ ^[0-9]{3}_[a-z_]+\.sql$ ]] || { echo "bad file name" >&2; exit 2; }
    sed -e "s/__SCHEMA__/${schema}/g" -e "s/__BUCKET__/${bucket}/g" -e "s/__ENV__/${env}/g" "$dir/$f" ;;
  check)
    run <<SQL
select
 (select count(*) from pg_class c join pg_namespace n on n.oid=c.relnamespace
   where n.nspname='${schema}' and c.relkind in ('r','p') and not c.relrowsecurity)           as tables_without_rls,
 (select count(*) from pg_policies where schemaname='${schema}'
   and roles && array['anon','public']::name[])                                              as policies_for_anon_or_public,
 (select count(*) from pg_policies where schemaname='${schema}'
   and (qual='true' or with_check='true'))                                                   as policies_true,
 (select count(*) from information_schema.role_table_grants
   where table_schema='${schema}' and grantee in ('anon','PUBLIC'))                          as table_grants_anon_or_public,
 (select count(*) from pg_proc p join pg_namespace n on n.oid=p.pronamespace
   where n.nspname='${schema}' and (has_function_privilege('anon', p.oid, 'EXECUTE')
     or exists (select 1 from aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) a
                where a.grantee = 0 and a.privilege_type = 'EXECUTE')))                     as functions_exec_anon_or_public,
 (select count(*) from pg_namespace where nspname='${schema}'
   and has_schema_privilege('anon', oid, 'USAGE'))                                          as schema_usage_anon,
 (select count(*) from pg_class c join pg_namespace n on n.oid=c.relnamespace
   where c.relname like 'healthapp%' and n.nspname not like 'healthapp\_%')
 +(select count(*) from pg_proc p join pg_namespace n on n.oid=p.pronamespace
   where p.proname like 'healthapp%' and n.nspname not like 'healthapp\_%')                 as our_objects_outside_schemas,
 (select count(*) from storage.buckets where id='${bucket}' and public)                    as bucket_public;
SQL
    ;;
  files)
    sed -e "s/__SCHEMA__/${schema}/g" "$dir/checks/file_analysis_counts.sql" | run ;;
  scan)
    sed -e "s/__SCHEMA__/${schema}/g" -e "s/__BUCKET__/${bucket}/g" "$dir/checks/scan_counts.sql" | run ;;
  kept)
    sed -e "s/__SCHEMA__/${schema}/g" "$dir/checks/refused_keeps_file_check.sql" | run ;;
  *) echo "usage: hdb render|check|files|scan|kept dev|demo [file]" >&2; exit 2;;
esac
